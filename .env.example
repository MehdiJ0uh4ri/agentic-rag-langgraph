# --- Claude ---------------------------------------------------------------
# Optional if you have run `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=sk-ant-...

# --- LangSmith tracing (on for every call) --------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=agentic-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Behaviour ------------------------------------------------------------
ARAG_MODEL=claude-opus-5
ARAG_GRADER_EFFORT=low
ARAG_ENABLE_WEB=true
ARAG_MAX_RETRIEVAL_ROUNDS=2
